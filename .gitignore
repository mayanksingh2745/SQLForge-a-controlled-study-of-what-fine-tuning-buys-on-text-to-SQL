# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Experiment artifacts, checkpoints, and models (DO NOT COMMIT)
artifacts/runs/*
!artifacts/runs/.gitkeep
artifacts/checkpoints/*
!artifacts/checkpoints/.gitkeep
artifacts/sweeps/*
!artifacts/sweeps/.gitkeep
models/checkpoints/*
!models/checkpoints/.gitkeep
models/weights/*
!models/weights/.gitkeep

# Datasets (DO NOT COMMIT RAW OR LARGE DATASETS)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated reports & figures
reports/figures/*
!reports/figures/.gitkeep

# Experiment tracking services
wandb/
.wandb/
mlruns/

# Environment variables & secrets (NEVER COMMIT SECRETS)
.env
.env.local
.env.*.local
*.pem
*.key

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
