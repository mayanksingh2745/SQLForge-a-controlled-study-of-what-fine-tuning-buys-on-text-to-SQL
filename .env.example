# ==============================================================================
# SQLForge Environment Configuration Example
# Copy this file to .env and populate with your local values.
# NEVER commit the .env file or real credentials to version control.
# ==============================================================================

# Project & Runtime Environment
SQLFORGE_ENV=development
SQLFORGE_LOG_LEVEL=INFO
SQLFORGE_SEED=42
SQLFORGE_OUTPUT_DIR=artifacts/runs

# Tracking (Optional - local JSON tracking is default and requires no keys)
WANDB_API_KEY=
WANDB_PROJECT=sqlforge-controlled-study
WANDB_ENTITY=
WANDB_MODE=offline

# Frontier API Reference Keys (Optional - only required for API baseline comparisons)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Hugging Face Hub (Optional - for downloading gated models/weights)
HF_TOKEN=

# Database Sandbox Execution Limits
SQLFORGE_EXECUTION_TIMEOUT_SECONDS=10.0
SQLFORGE_MAX_MEMORY_MB=1024
SQLFORGE_MAX_ROW_LIMIT=5000
